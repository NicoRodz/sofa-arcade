{
  "name": "party-game",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "platform/*",
    "games/*",
    "apps/*",
    "tools/latency-report"
  ],
  "scripts": {
    "dev": "tsx apps/server/src/main.ts dev",
    "start": "tsx apps/server/src/main.ts static",
    "build": "npm run build -w @pichi/app-screen -w @pichi/app-controller",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tools/meta && tsc -p scripts",
    "move": "tsx scripts/move.ts",
    "test": "vitest run",
    "test:fast": "vitest run --project '!slow'",
    "test:slow": "vitest run --project slow",
    "test:agent": "vitest run --reporter=dot --silent",
    "size:ratchet": "tsx tools/meta/size-budget.ts ratchet",
    "baseline:write": "tsx tools/meta/baseline.ts write",
    "baseline:check": "tsx tools/meta/baseline.ts check",
    "lint": "biome check",
    "deps": "depcruise --config .dependency-cruiser.cjs platform games apps tools",
    "deps:report": "tsx tools/meta/deps-report.ts",
    "report": "tsx tools/latency-report/src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "dependency-cruiser": "^17.4.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
